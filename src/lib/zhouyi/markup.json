"<div class=\"shell\">\r\n    <div>\r\n      <section aria-label=\"起卦与复盘\">\r\n        <div class=\"toolbar\">\r\n          <div class=\"manual-field\">\r\n            <label for=\"manualInput\">六爻复盘</label>\r\n            <input id=\"manualInput\" type=\"text\" autocomplete=\"off\" spellcheck=\"false\" aria-describedby=\"manualHint\" placeholder=\"六爻值、本卦_之卦或参考链接\">\r\n            <button id=\"manualButton\" class=\"button\" type=\"button\">解卦</button>\r\n          </div>\r\n          <div class=\"toolbar-actions\">\r\n          <div id=\"historyActions\" class=\"history-actions\" role=\"group\" aria-label=\"卦象历史\" hidden>\r\n            <button id=\"undoButton\" class=\"icon-button\" type=\"button\" aria-label=\"撤销\" title=\"撤销（Ctrl/Cmd+Z）\" disabled><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 5 4 10l5 5M4 10h10a6 6 0 0 1 0 12\" transform=\"translate(0 -2)\"/></svg></button>\r\n            <button id=\"redoButton\" class=\"icon-button\" type=\"button\" aria-label=\"重做\" title=\"重做（Ctrl/Cmd+Shift+Z）\" disabled><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m15 5 5 5-5 5m5-5H10a6 6 0 0 0 0 12\" transform=\"translate(0 -2)\"/></svg></button>\r\n          </div>\r\n          <div class=\"view-switch\" role=\"group\" aria-label=\"观卦方式\">\r\n            <button id=\"singleHexagramButton\" type=\"button\" aria-pressed=\"false\" aria-label=\"观卦，阅读本卦经文\" title=\"本卦卦图与经文\">观卦</button>\r\n            <button id=\"twoHexagramsButton\" type=\"button\" aria-pressed=\"true\" aria-label=\"观变，两卦对照与变占\" title=\"两卦对照与朱子变占\">观变</button>\r\n          </div>\r\n          </div>\r\n        </div>\r\n\r\n      </section>\r\n      <p id=\"errorBox\" class=\"error\" role=\"alert\" hidden></p>\r\n      <p id=\"historyStatus\" class=\"sr-only\" role=\"status\"></p>\r\n      <section id=\"emptyState\" class=\"empty-state\"><div id=\"emptySymbol\" class=\"empty-symbol\" aria-hidden=\"true\"></div><h2>静心，起一卦</h2><p>揲蓍起卦，或输入已有六爻值读易。</p><button id=\"emptyPickerButton\" class=\"button\" type=\"button\">选卦</button></section>\r\n      <section id=\"resultSection\" class=\"result\" hidden>\r\n        <div class=\"reading-layout\">\r\n        <div id=\"hexagramGrid\" class=\"hexagram-grid\"></div>\r\n        <section id=\"readingPanel\" class=\"tab-panel\" aria-labelledby=\"readingHeading\">\r\n          <h2 id=\"readingHeading\" class=\"sr-only\">经文与取辞</h2>\r\n          <div class=\"rule-line\">\r\n            <header class=\"result-header\">\r\n              <div class=\"result-title-row\"><span id=\"baseSymbol\" class=\"title-symbol\" aria-hidden=\"true\"></span><h2 id=\"resultTitle\" tabindex=\"-1\">起卦结果</h2><span id=\"changedSymbol\" class=\"title-symbol\" aria-hidden=\"true\"></span></div>\r\n              <p id=\"resultSummary\" class=\"sr-only\" aria-live=\"polite\"></p>\r\n            </header>\r\n            <p id=\"readingRule\"></p><div id=\"readingPassages\" class=\"rule-passages\"></div>\r\n          </div>\r\n          <div id=\"readingNotes\"></div>\r\n          <div id=\"scriptureContent\" class=\"scripture-grid\"></div>\r\n        </section>\r\n        </div>\r\n        \r\n        \r\n      </section>\r\n      <section class=\"bottom-tools\" aria-label=\"起卦选项\">\r\n        <div class=\"tool-grid\">\r\n          <details class=\"settings\" id=\"settingsDetails\">\r\n            <summary>自动起卦</summary>\r\n            <div class=\"settings-box\">\r\n              <label for=\"seedInput\">复现种子（可选）</label>\r\n              <input id=\"seedInput\" type=\"text\" autocomplete=\"off\" placeholder=\"留空随机起卦\">\r\n              <label for=\"verboseInput\"><input id=\"verboseInput\" type=\"checkbox\"> 起卦后显示十八变过程</label>\r\n              <button id=\"castButton\" class=\"button primary\" type=\"button\">揲蓍起卦</button>\r\n            </div>\r\n          </details>\r\n          <details id=\"tracePanel\" class=\"relations\" hidden><summary>揲蓍过程</summary><div id=\"traceContent\" class=\"trace-content\"></div></details>\r\n          <details id=\"relationsDetails\" class=\"relations\" hidden><summary>卦象关系</summary><div id=\"relationsContent\" class=\"relations-content\"></div></details>\r\n          <details class=\"settings\" id=\"displaySettingsDetails\">\r\n          <summary>显示设置</summary>\r\n          <div class=\"settings-box display-options\">\r\n            <label><input id=\"showHexKind\" type=\"checkbox\"> 卦别（本卦 / 之卦）</label>\r\n            <label><input id=\"showLineLabels\" type=\"checkbox\"> 爻位（上九、六五等）</label>\r\n            <label><input id=\"showLineValues\" type=\"checkbox\"> 爻值与动爻符号（9○、6×等）</label>\r\n            <label><input id=\"showHexNumbers\" type=\"checkbox\"> 卦序（38、51等）</label>\r\n          </div>\r\n        </details>\r\n        </div>\r\n        <div class=\"toolbar-foot\"><span id=\"manualHint\" title=\"6 老阴、7 少阳、8 少阴、9 老阳\">初爻 → 上爻</span><button id=\"exampleButton\" class=\"text-button\" type=\"button\">示例</button></div>\r\n      </section>\r\n    </div>\r\n  </div>\r\n\r\n  <dialog id=\"hexagramPicker\" class=\"hexagram-picker\" aria-labelledby=\"pickerTitle\">\r\n    <header class=\"picker-header\"><h2 id=\"pickerTitle\">选卦</h2><button id=\"closePickerButton\" class=\"icon-button\" type=\"button\" aria-label=\"关闭选卦\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button></header>\r\n    <input id=\"pickerSearch\" class=\"picker-search\" type=\"text\" autocomplete=\"off\" spellcheck=\"false\" aria-label=\"搜索卦名或卦序\" placeholder=\"卦名或卦序\">\r\n    <div id=\"pickerGrid\" class=\"picker-grid\" role=\"group\" aria-label=\"六十四卦\"></div>\r\n    <p id=\"pickerEmpty\" class=\"picker-empty\" role=\"status\" hidden>未找到对应的卦</p>\r\n  </dialog>"
